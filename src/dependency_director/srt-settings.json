{
  "network": {
    "allowedDomains": [
      "*.crates.io",
      "*.docker.io",
      "*.pkg.dev",
      "api.bitbucket.org",
      "api.github.com",
      "api.gitlab.com",
      "bitbucket.org",
      "codeload.github.com",
      "crates.io",
      "files.pythonhosted.org",
      "ghcr.io",
      "github.com",
      "gitlab.com",
      "mcr.microsoft.com",
      "objects.githubusercontent.com",
      "pkg-containers.githubusercontent.com",
      "production.cloudflare.docker.com",
      "proxy.golang.org",
      "public.ecr.aws",
      "pypi.org",
      "quay.io",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "release-assets.githubusercontent.com",
      "ssh.dev.azure.com"
    ],
    "deniedDomains": [
      "*.ngrok.io",
      "*.pipedream.com",
      "*.webhook.site",
      "*.requestbin.com"
    ]
  },
  "filesystem": {
    "denyRead": ["~"],
    "allowRead": [
      "~/.bun/bin",
      "~/.bun/install/cache",
      "~/.cache/pip",
      "~/.cache/uv",
      "~/.cache/yarn",
      "~/.cache/pipenv",
      "~/.cargo/bin",
      "~/.cargo/registry",
      "~/.cocoapods",
      "~/.composer/vendor",
      "~/.conan/data",
      "~/.conan2/p",
      "~/.conda/envs",
      "~/.conda/pkgs",
      "~/.config/alire",
      "~/.cpan",
      "~/.cpanm",
      "~/.gradle/caches",
      "~/.gradle/wrapper",
      "~/.local/bin",
      "~/.local/share/gem",
      "~/.local/share/mise/installs",
      "~/.local/share/mise/shims",
      "~/.local/share/uv/python",
      "~/.local/share/uv/tools",
      "~/.local/share/virtualenvs",
      "~/.m2/repository",
      "~/.matlab",
      "~/.npm/_cacache",
      "~/.nuget/packages",
      "~/.pnpm-state",
      "~/.pnpm-store",
      "~/.pyenv/versions",
      "~/.pyenv/shims",
      "~/.rustup/toolchains",
      "~/.rustup/settings.toml",
      "~/.swiftpm",
      "~/.yarn",
      "~/go/pkg/mod",
      "~/go/bin"
    ],
    "allowWrite": ["/tmp"],
    "denyWrite": [".env", ".git/hooks"],
    "allowGitConfig": false
  },
  "enableWeakerNetworkIsolation": false
}
